{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nodeMajor": 20,
  "schedule": ["after 10pm on the 15th day of February, May, August, November"],
  "group": {
    "npm": {
      "enabled": true,
      "groupName": "all npm dependencies",
      "groupSlug": "quarterly-updates"
    }
  },
  "postUpgradeTasks": {
    "commands": [
      "npm install --legacy-peer-deps",
      "npm test"
    ],
    "fileMatch": ["package.json"]
  },
  "automerge": false,
  "prPriority": 30,
  "changelog": {
    "enabled": true
  },
  "labels": ["dependencies", "quarterly-update"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1
}